# --- Fixtures ---------------------------------------------------------------
# Provider: "footballdata" (football-data.org, free tier) | "apifootball" | "mock"
FIXTURES_PROVIDER=footballdata
FOOTBALL_DATA_API_KEY=
# Competition code synced by scripts/sync-fixtures.ts (PL = Premier League)
FOOTBALL_DATA_COMPETITION=PL

# If using API-Football via RapidAPI instead:
API_FOOTBALL_KEY=
API_FOOTBALL_LEAGUE=39
API_FOOTBALL_SEASON=2026

# --- YouTube ----------------------------------------------------------------
YOUTUBE_API_KEY=

# --- Tagging agent (optional) -----------------------------------------------
# Without a key the tagger falls back to the deterministic heuristic scorer.
ANTHROPIC_API_KEY=
# Haiku is plenty for picking one of three labelled options, and ~30x cheaper.
TAGGER_MODEL=claude-haiku-4-5-20251001

# --- Cron auth --------------------------------------------------------------
# Shared secret required by /api/cron/* routes (send as ?key= or Bearer token).
CRON_SECRET=dev-secret-change-me
